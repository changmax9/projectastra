FROM node:20-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-pip tesseract-ocr tesseract-ocr-eng \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY requirements-worker.txt ./
RUN pip3 install --break-system-packages --no-cache-dir -r requirements-worker.txt

COPY . .
ENV PDF_OCR_MODE=local
ENV PDF_OCR_PYTHON=/usr/bin/python3
ENV PDF_TEXT_PYTHON=/usr/bin/python3
ENV TESSERACT_CMD=/usr/bin/tesseract
ENV PDF_OCR_PSM=3
ENV PDF_OCR_MAX_PAGES=0
ENV PDF_WORKER_BATCH_SIZE=12
ENV PDF_WORKER_MAX_PAGES=2000

CMD ["npm", "run", "worker:pdf-import"]
