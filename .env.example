# Public Supabase values. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role key. Never import or expose this in client components.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
PDF_OCR_MODE=local
ADMIN_EMAIL=
ADMIN_PASSWORD=
STUDENT_EMAIL=
STUDENT_PASSWORD=
SESSION_SECRET=
SHOW_DEMO_CREDENTIALS=false

# Local PDF OCR controls.
PDF_OCR_MAX_PAGES=12
PDF_OCR_PSM=3
PDF_OCR_TIMEOUT_MS=
PDF_OCR_TRIAGE_SAMPLE_PAGES=48
PDF_OCR_TRIAGE_TIMEOUT_MS=120000
PDF_OCR_PYTHON=D:\Anaconda\python.exe
PDF_OCR_PYTHONPATH=D:\Codex\tools\pdf-ocr-python
TESSERACT_CMD=D:\Codex\tools\tesseract-ocr\tesseract.exe

# Remote PDF worker and Cloudflare R2.
PDF_WORKER_ID=
PDF_WORKER_SMOKE=
PDF_WORKER_POLL_MS=5000
PDF_WORKER_BATCH_SIZE=12
PDF_WORKER_MAX_PAGES=2000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_SOURCE_BUCKET=astra-pdf-sources
R2_EVIDENCE_BUCKET=astra-pdf-evidence
R2_EVIDENCE_PUBLIC_URL=
